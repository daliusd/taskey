{
  "name": "@daliusd/taskey",
  "version": "0.1.1",
  "description": "Human-friendly task management CLI with explicit JSON mode for AI agents",
  "type": "module",
  "bin": {
    "taskey": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CLI_CONTRACT.md",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:skill": "tsx scripts/run-skill-evals.ts --repo skills/taskey/evals/fixtures/minimal-repo --thinking medium",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "task-management",
    "cli",
    "json",
    "ai-agents"
  ],
  "author": "daliusd <dalius.dobravolskas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daliusd/taskey.git"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
